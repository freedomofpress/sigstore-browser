{
  "name": "@freedomofpress/sigstore-browser",
  "version": "0.2.0",
  "description": "A minimal browser-only Sigstore verification library.",
  "repository": {
    "type": "git",
    "url": "https://github.com/freedomofpress/sigstore-browser"
  },
  "main": "dist/index.js",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --config vite.config.playwright.ts",
    "test:node": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --fix"
  },
  "keywords": [
    "sigstore",
    "rekor",
    "browser",
    "typescript"
  ],
  "author": "Giulio B",
  "license": "MIT",
  "devDependencies": {
    "@noble/curves": "^2.0.1",
    "@types/node": "^24.0.14",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "playwright": "^1.57.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@freedomofpress/crypto-browser": "^0.3.0",
    "@freedomofpress/tuf-browser": "^0.3.0"
  }
}
